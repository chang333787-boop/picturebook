{
  "rules": {
    "admin": {
      ".read": false,
      ".write": false
    },
    "classCodes": {
      ".read": true,
      "$code": {
        ".write": "auth != null && !data.exists() && newData.isString() && $code.matches(/^[A-Z0-9]{4,6}$/) && root.child('classes/' + newData.val() + '/meta/teacher_uid').val() === auth.uid"
      }
    },
    "teacherClasses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && root.child('classes/' + newData.val() + '/meta/teacher_uid').val() === auth.uid"
      }
    },
    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('createdAt').val() === newData.child('createdAt').val())"
      }
    },
    "classes": {
      "$classId": {
        "meta": {
          ".read": "auth != null && (auth.token.role === 'super_admin' || auth.token.role === 'teacher' || data.child('teacher_uid').val() === auth.uid)",
          ".write": "auth != null && ((!data.exists() && newData.child('teacher_uid').val() === auth.uid) || data.child('teacher_uid').val() === auth.uid || auth.token.role === 'super_admin')"
        },
        "aiSettings": {
          ".read": true,
          ".write": "auth != null && (root.child('classes/' + $classId + '/meta/teacher_uid').val() === auth.uid || auth.token.role === 'super_admin')"
        },
        "teams": {
          ".read": true,
          "$team": {
            "pin": {
              ".read": true,
              ".write": "auth != null && !data.exists()"
            },
            "scenes": {
              ".read": true,
              ".write": "auth != null"
            },
            "locks": {
              ".read": true,
              ".write": "auth != null"
            },
            "viewer-meta": {
              ".read": true,
              ".write": "auth != null"
            },

            "aiPermission": {
              ".read": true,
              ".write": "auth != null"
            },
            "branchLineage": {
              ".read": true,
              ".write": "auth != null"
            },
            "aiDrafts": {
              ".read": true,
              ".write": false
            },
            "aiVariants": {
              ".read": true,
              ".write": false
            }
          }
        }
      }
    },

    "ai-usage": {
      ".read": false,
      ".write": false
    },
    "ai-usage-by-root": {
      ".read": false,
      ".write": false
    },
    "ai-usage-global": {
      ".read": false,
      ".write": false
    },
    "ai-kill-switch": {
      ".read": true,
      ".write": false
    },
    "ai-stats": {
      ".read": false,
      ".write": false
    },
    "teams": {
      ".read": true,
      "$team": {
        "pin": {
          ".read": true,
          ".write": "auth != null && !data.exists()"
        },
        "scenes": {
          ".read": true,
          ".write": "auth != null"
        },
        "locks": {
          ".read": true,
          ".write": "auth != null"
        },
        "viewer-meta": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "copyCodes": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
