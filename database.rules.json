{
  "rules": {
    "admin": {
      ".read": false,
      ".write": false
    },
    "classCodes": {
      ".read": true,
      ".write": false
    },
    "teacherClasses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('createdAt').val() === newData.child('createdAt').val())"
      }
    },
    "classes": {
      "$classId": {
        "meta": {
          ".read": "auth != null && (auth.token.role === 'super_admin' || auth.token.role === 'teacher')",
          ".write": "auth != null && auth.token.role === 'super_admin'"
        },
        "teams": {
          ".read": true,
          "$team": {
            "pin": {
              ".read": true,
              ".write": "auth != null && !data.exists()"
            },
            "scenes": {
              ".read": true,
              ".write": "auth != null"
            },
            "locks": {
              ".read": true,
              ".write": "auth != null"
            },
            "viewer-meta": {
              ".read": true,
              ".write": "auth != null"
            }
          }
        }
      }
    },
    "teams": {
      ".read": true,
      "$team": {
        "pin": {
          ".read": true,
          ".write": "auth != null && !data.exists()"
        },
        "scenes": {
          ".read": true,
          ".write": "auth != null"
        },
        "locks": {
          ".read": true,
          ".write": "auth != null"
        },
        "viewer-meta": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "copyCodes": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
